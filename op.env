# This file contains only op:// references. `op run --env-file=op.env` gets their values
# at run time. The secrets are in one vault, addressed by UUID. Thus, the references stay
# correct when the vault gets a new name. The item is dropbox. Refer to katoptra/lib, Secrets.
MIRROR_DROPBOX_APP_KEY=op://y6y6b6l2zjbpv7szc5ym5sprne/dropbox/dropbox/app_key
MIRROR_DROPBOX_APP_SECRET=op://y6y6b6l2zjbpv7szc5ym5sprne/dropbox/dropbox/app_secret
MIRROR_DROPBOX_REFRESH_TOKEN=op://y6y6b6l2zjbpv7szc5ym5sprne/dropbox/dropbox/refresh_token
MIRROR_DROPBOX_ACCOUNT_ID=op://y6y6b6l2zjbpv7szc5ym5sprne/dropbox/dropbox/account_id
MIRROR_PROTON_DESTINATION=op://y6y6b6l2zjbpv7szc5ym5sprne/dropbox/proton/destination
MIRROR_PROTON_DESTINATION_UID=op://y6y6b6l2zjbpv7szc5ym5sprne/dropbox/proton/destination_uid
AWS_ACCESS_KEY_ID=op://y6y6b6l2zjbpv7szc5ym5sprne/dropbox/r2/access_key_id
AWS_SECRET_ACCESS_KEY=op://y6y6b6l2zjbpv7szc5ym5sprne/dropbox/r2/secret_access_key
AWS_ENDPOINT_URL_S3=op://y6y6b6l2zjbpv7szc5ym5sprne/dropbox/r2/endpoint
MIRROR_R2_BUCKET=op://y6y6b6l2zjbpv7szc5ym5sprne/dropbox/r2/bucket
MIRROR_AGE_IDENTITY=op://y6y6b6l2zjbpv7szc5ym5sprne/dropbox/age/identity
HEALTHCHECK_URL=op://y6y6b6l2zjbpv7szc5ym5sprne/dropbox/healthcheck/url
